# Copy this file to .env.local (or .env) and set your values.
# React only exposes variables prefixed with REACT_APP_.

# Keep your current basemap URL/style endpoint here.
# Example Mapbox raster style endpoint:
# REACT_APP_BASEMAP_TILE_URL=https://api.mapbox.com/styles/v1/relnox/ck0h5xn701bpr1dqs3he2lecq/tiles/256/{z}/{x}/{y}
# Example CARTO raster endpoint (if using key-protected CARTO URLs):
# REACT_APP_BASEMAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/dark_nolabels/{z}/{x}/{y}.png
REACT_APP_BASEMAP_TILE_URL=

# Required only if your basemap endpoint is Mapbox and does not already include access_token.
REACT_APP_MAPBOX_TOKEN=

# Optional. Used when REACT_APP_BASEMAP_TILE_URL is a CARTO endpoint that requires a key.
REACT_APP_CARTO_API_KEY=
